# MindmapChat 环境变量模板
# 复制为 .env 并填写真实值。切勿将 .env 提交到版本库。
#
# 服务端密钥（必填，缺失时 server-prod.js 会拒绝启动）
JWT_SECRET=请替换为一段足够长的随机字符串

# 管理员白名单（可选，逗号分隔多个用户名）
# 注册该用户名（或该用户已存在时重启服务）后即为管理员，可配置全局模型密钥
MINDMAPCHAT_ADMIN_USERNAME=admin

# 阿里云百炼（DashScope）模型凭据
DASHSCOPE_API_KEY=sk-xxxx
ALIYUN_WORKSPACE_ID=ws-xxxx

# 腾讯混元 TokenHub 凭据（可选，仅在选用腾讯供应商时需要）
TENCENT_TOKENHUB_API_KEY=sk-xxxx

# PostgreSQL 连接参数（默认连接本地 localhost，请按实际修改）
PG_HOST=localhost
PG_PORT=5432
PG_USER=pg
PG_PASSWORD=请替换为数据库密码
PG_DATABASE=thinkchat

# 文件上传后拼接的公网访问地址（形如 http://your-host:11113）
# 留空则生成的 URL 仅为相对路径 /uploads/xxx
BASE_URL=

# 桌面端默认连接的服务端地址（可选，默认 http://localhost:11113）
MINDMAPCHAT_SERVER_URL=http://localhost:11113
